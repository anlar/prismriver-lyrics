#body {
    height: 1fr;
}

#left-column {
    width: 1fr;
    margin: 0 0 0 1;
}

#metadata-container {
    border: round $accent;
    height: auto;
    padding: 1 0;
    background: $background;
}

#now-playing {
    padding: 0 1;
}

#now-playing MarkdownParagraph,
#now-playing MarkdownBulletList {
    margin-bottom: 0;
}

#now-playing MarkdownHorizontalRule {
    margin-bottom: 0;
}

#now-playing MarkdownBlock > .em {
    text-style: dim;
}

#player-list {
    border: round $accent;
    height: 3;
    background: $background;
}

#results-list {
    border: round $accent;
    height: 1fr;
    background: $background;
}

#lyrics-container {
    width: 2fr;
    border: round $accent;
    margin: 0 1 0 0;
    padding: 1 2;
    background: $background;
}

#player-list:focus,
#results-list:focus,
#lyrics-container:focus {
    border: round $primary;
    background-tint: $background 0%;
}

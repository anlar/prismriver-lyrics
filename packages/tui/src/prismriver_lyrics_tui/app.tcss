#body {
    height: 1fr;
}

#left-column {
    width: 1fr;
    margin: 0 0 0 1;
}

#metadata-container {
    border: round $accent;
    height: auto;
    padding: 1 2;
}

#player-list {
    border: round $accent;
    height: 3;
}

#results-list {
    border: round $accent;
    height: 1fr;
}

#lyrics-container {
    width: 2fr;
    border: round $secondary;
    margin: 0 1 0 0;
    padding: 1 2;
}

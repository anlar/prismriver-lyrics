#body {
    height: 1fr;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: $footer-background;
    color: $footer-foreground;
}

#status-bar-app {
    width: auto;
    height: 1;
    padding: 0 1;
    text-wrap: nowrap;
}

#status-bar-hotkeys {
    width: 1fr;
    height: 1;
    padding: 0 1;
    text-align: right;
    text-wrap: nowrap;
}

#left-column {
    width: 1fr;
    margin: 0 0 0 1;
}

#metadata-container {
    border: round $accent;
    height: auto;
    padding: 1 0;
    background: $background;
}

#song-title {
    padding: 0 1;
    margin-bottom: 1;
    text-style: bold;
}

#song-title.placeholder {
    text-style: italic dim;
}

#song-fields {
    grid-size: 2;
    grid-columns: 9 1fr;
    grid-rows: auto;
    height: auto;
    padding: 0 1;
}

.song-field-label {
    text-style: dim;
}

#song-progress-row {
    height: 1;
    padding: 0 1;
    margin-top: 1;
}

#song-progress-row ProgressBar {
    width: 1fr;
}

#song-progress-row Bar {
    width: 1fr;
}

#song-progress-row Bar > .bar--bar,
#song-progress-row Bar > .bar--indeterminate,
#song-progress-row Bar > .bar--complete {
    background: $panel;
}

#song-position {
    width: 6;
    text-align: right;
}

#player-list {
    border: round $accent;
    height: 3;
    background: $background;
}

#player-list > .option-list--option-disabled {
    color: $text-muted;
}

#results-list {
    border: round $accent;
    height: 1fr;
    background: $background;
}

#status-line {
    height: 1;
    padding: 0 1;
    margin-top: 1;
    text-style: dim;
}

#lyrics-container {
    width: 2fr;
    border: round $accent;
    margin: 0 1 0 0;
    background: $background;
}

#lyrics-tabs {
    background: $background;
}

#lyrics-tabs Tabs {
    display: none;
}

#lyrics-plain-scroll,
#lyrics-sync-view {
    padding: 1 2;
}

#lyrics.placeholder {
    text-style: dim;
}

#lyrics-sync-view .current-line {
    text-style: bold;
    color: $text-primary;
}

#player-list:focus,
#results-list:focus,
#lyrics-container:focus-within {
    border: round $primary;
    background-tint: $background 0%;
}

SearchDialog {
    align: center middle;
}

#search-dialog {
    width: 100;
    height: auto;
    border: round $accent;
    background: $background;
    padding: 1;
}

#search-dialog Label {
    margin-bottom: 1;
}

#search-dialog Input {
    border: none;
    height: 1;
    margin-bottom: 1;
}

#search-dialog Input:focus {
    border: none;
}
